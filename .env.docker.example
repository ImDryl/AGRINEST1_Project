# Copy to .env.docker for: docker compose -f docker-compose.deploy.yaml --env-file .env.docker up --build
# Do NOT commit .env.docker with real passwords.

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=agrinest_db
MYSQL_USER=agrinest_user
MYSQL_PASSWORD=change_me_db
MYSQL_PORT=3306
APP_PORT=8000
PMA_PORT=8082

APP_SECRET=change_me_long_random_string
JWT_PASSPHRASE=change_me_jwt_passphrase

DEFAULT_URI=http://127.0.0.1:8000
CORS_ALLOW_ORIGIN='^https?://.*$'

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/connect/google/check
GOOGLE_MOBILE_WEB_CLIENT_ID=

MAILER_DSN=
MAILER_SMTP_USER=
MAILER_SMTP_PASSWORD=
MAILER_FROM_EMAIL=
MAILER_FROM_NAME=AGRINEST
