<div class="page-header">
    <h1><i class="bi bi-journal-text"></i> Activity Logs</h1>
    <div class="header-info">
        <span class="badge badge-info">Total: {{ totalLogs }}</span>
    </div>
</div>

<div class="card">
    <div class="filter-section">
        <form method="GET" action="{{ path('app_admin_logs_index') }}" class="filter-form">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="username"><i class="bi bi-person"></i> User</label>
                    <select name="username" id="username" class="form-control">
                        <option value="">All Users</option>
                        {% for u in allUsernames %}
                            <option value="{{ u }}" {{ username == u ? 'selected' : '' }}>{{ u }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-group">
                    <label for="action"><i class="bi bi-activity"></i> Action</label>
                    <select name="action" id="action" class="form-control">
                        <option value="">All Actions</option>
                        {% for a in allActions %}
                            <option value="{{ a }}" {{ action == a ? 'selected' : '' }}>{{ a }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-group">
                    <label for="date_from"><i class="bi bi-calendar-event"></i> Date From</label>
                    <input type="date" name="date_from" id="date_from" class="form-control" value="{{ dateFrom }}">
                </div>

                <div class="filter-group">
                    <label for="date_to"><i class="bi bi-calendar-check"></i> Date To</label>
                    <input type="date" name="date_to" id="date_to" class="form-control" value="{{ dateTo }}">
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <a href="{{ path('app_admin_logs_index') }}" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Clear
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="table-container">
        <table class="styled-table logs-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    <tr>
                        <td>{{ log.id }}</td>
                        <td>
                            <span class="username-badge">{{ log.username }}</span>
                        </td>
                        <td>
                            {% if log.role == 'Admin' %}
                                <span class="badge badge-admin">{{ log.role }}</span>
                            {% elseif log.role == 'Staff' %}
                                <span class="badge badge-staff">{{ log.role }}</span>
                            {% else %}
                                <span class="badge badge-user">{{ log.role }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if log.action == 'Create' %}
                                <span class="action-badge action-create">
                                    <i class="bi bi-plus-circle"></i> {{ log.action }}
                                </span>
                            {% elseif log.action == 'Update' %}
                                <span class="action-badge action-update">
                                    <i class="bi bi-pencil"></i> {{ log.action }}
                                </span>
                            {% elseif log.action == 'Delete' %}
                                <span class="action-badge action-delete">
                                    <i class="bi bi-trash"></i> {{ log.action }}
                                </span>
                            {% elseif log.action == 'Login' %}
                                <span class="action-badge action-login">
                                    <i class="bi bi-box-arrow-in-right"></i> {{ log.action }}
                                </span>
                            {% elseif log.action == 'Logout' %}
                                <span class="action-badge action-logout">
                                    <i class="bi bi-box-arrow-right"></i> {{ log.action }}
                                </span>
                            {% else %}
                                <span class="action-badge">{{ log.action }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if log.entityType %}
                                <span class="entity-badge">{{ log.entityType }}{% if log.entityId %} #{{ log.entityId }}{% endif %}</span>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td class="details-cell">
                            {% if log.details %}
                                <button type="button" class="btn-details" onclick="toggleDetails({{ log.id }})">
                                    <i class="bi bi-eye"></i> View Details
                                </button>
                                <div id="details-{{ log.id }}" class="details-content" style="display: none;">
                                    <pre>{{ log.details }}</pre>
                                </div>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="timestamp">{{ log.timestamp|date('Y-m-d H:i:s') }}</span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="no-data">No logs found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
    <div class="table-footer">
        <div class="page-info">
            Showing page {{ page }} of {{ totalPages }} ({{ totalLogs }} total logs)
        </div>
        <div class="pagination">
            {% if page > 1 %}
                <a href="{{ path('app_admin_logs_index', app.request.query.all|merge({page: page - 1})) }}" class="btn btn-sm">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            {% endif %}
            
            {% for p in 1..totalPages %}
                {% if p == page %}
                    <span class="btn btn-sm btn-active">{{ p }}</span>
                {% elseif p <= 3 or p > totalPages - 3 or (p >= page - 1 and p <= page + 1) %}
                    <a href="{{ path('app_admin_logs_index', app.request.query.all|merge({page: p})) }}" class="btn btn-sm">{{ p }}</a>
                {% elseif p == 4 or p == totalPages - 3 %}
                    <span class="btn btn-sm disabled">...</span>
                {% endif %}
            {% endfor %}
            
            {% if page < totalPages %}
                <a href="{{ path('app_admin_logs_index', app.request.query.all|merge({page: page + 1})) }}" class="btn btn-sm">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>

<script>
function toggleDetails(logId) {
    const details = document.getElementById('details-' + logId);
    if (details.style.display === 'none') {
        details.style.display = 'block';
    } else {
        details.style.display = 'none';
    }
}
</script>

