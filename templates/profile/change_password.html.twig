{% extends 'admin/base_admin.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block admin_content %}
<div class="profile-wrapper">
  <div class="profile-header-simple">
    <h1><i class="bi bi-key"></i> Change Password</h1>
  </div>

  <div class="profile-card-simple">
    {% for message in app.flashes('error') %}
      <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> {{ message }}
      </div>
    {% endfor %}

    {% for message in app.flashes('success') %}
      <div class="alert alert-success">
        <i class="bi bi-check-circle"></i> {{ message }}
      </div>
    {% endfor %}

    {{ form_start(form, {'attr': {'class': 'password-form-simple'}}) }}
      
      <div class="form-group">
        <label for="{{ form.currentPassword.vars.id }}">
          <i class="bi bi-lock"></i> Current Password
        </label>
        {{ form_widget(form.currentPassword, {
          'attr': {
            'class': 'form-control',
            'placeholder': 'Enter your current password'
          }
        }) }}
        {{ form_errors(form.currentPassword) }}
      </div>

      <div class="form-group">
        <label for="{{ form.plainPassword.first.vars.id }}">
          <i class="bi bi-key"></i> New Password
        </label>
        {{ form_widget(form.plainPassword.first, {
          'attr': {
            'class': 'form-control',
            'placeholder': 'Enter new password (min. 6 characters)'
          }
        }) }}
        {{ form_errors(form.plainPassword.first) }}
      </div>

      <div class="form-group">
        <label for="{{ form.plainPassword.second.vars.id }}">
          <i class="bi bi-key-fill"></i> Confirm New Password
        </label>
        {{ form_widget(form.plainPassword.second, {
          'attr': {
            'class': 'form-control',
            'placeholder': 'Confirm new password'
          }
        }) }}
        {{ form_errors(form.plainPassword.second) }}
      </div>

      <div class="profile-actions-simple">
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-save"></i> Update Password
        </button>
        <a href="{{ path('app_profile') }}" class="btn btn-secondary">
          <i class="bi bi-x-circle"></i> Cancel
        </a>
      </div>
    {{ form_end(form) }}
  </div>
</div>
{% endblock %}

