{% extends isAdmin|default(false) ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Product List{% endblock %}

{% block admin_content %}
    {% embed 'product/_index_content.html.twig' %}{% endembed %}
{% endblock %}

{% block body %}
    {% if isAdmin|default(false) %}
        {{ parent() }}
    {% else %}
        {% include 'includes/_navbar_public.html.twig' %}
        <div class="shop-page-wrap">
            {% embed 'product/_collection_content.html.twig' %}{% endembed %}
        </div>
        {{ include('homepage/_footer.html.twig') }}
    {% endif %}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {% if isAdmin|default(false) %}
    <link rel="stylesheet" href="{{ asset('css/product-table.css') }}?v=1">
  {% else %}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
    <link rel="stylesheet" href="{{ asset('css/product-collection.css') }}?v=7">
  {% endif %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {% if isAdmin|default(false) %}
    {% include 'includes/inline/_product_table_js.html.twig' %}
  {% endif %}
{% endblock %}