{% extends 'base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block body %}

    <h1>🧺Product</h1>
<div class="table-container">
    <table class="product-table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Description</th>
                <th>Image</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.name }}</td>
                <td>{{ product.category ? product.category.name : 'No category' }}</td>
                <td>{{ product.price }}</td>
                <td>{{ product.quantity }}</td>
                <td>{{ product.description }}</td>
                <td>
                     {{ product.image ? product.image : 'No image' }}
                </td>
                
                <td>{{ product.date ? product.date|date('Y-m-d') : '' }}</td>
                <td class="actions">
                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn-show">Show</a>
                    <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn-edit">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
    <a href="{{ path('app_product_new') }}" class="create-btn">+ Create New</a>
{% endblock %}
