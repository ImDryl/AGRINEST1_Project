{% extends 'base.html.twig' %}

{% block title %}Create new Product{% endblock %}

{% block body %}
      

    <div class="form-container">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="form-actions">
                <button class="btn btn-success btn-sm">
                    Save
                </button>
                <a href="{{ path('app_product_index') }}" class="btn btn-secondary btn-sm">
                    ↩ Back to list
                </a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}