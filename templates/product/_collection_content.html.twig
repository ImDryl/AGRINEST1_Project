<div class="collection-page">
    <div id="shopCartToast" class="shop-cart-toast" aria-live="polite"></div>
    {% set shop_hero_image = asset('images/banner.png') %}
    <section class="shop-hero-banner" style="--shop-hero-image: url('{{ shop_hero_image }}');" aria-label="Shop banner">
        <div class="shop-hero-banner__overlay"></div>
    </section>

    <div class="collection-hero">
        <h1><i class="bi bi-shop-window"></i> Shop</h1>
        {# <p>Fresh poultry products available. View details and stock below.</p> #}
    </div>

    <form method="get" action="{{ path('app_product_index') }}" class="collection-controls collection-controls-form">
        <input type="hidden" name="page" value="1">
        <div class="control-group">
            <label for="shop_limit" style="font-weight:600;">Show</label>
            <select id="shop_limit" name="limit">
                <option value="6" {{ shopLimit == 6 ? 'selected' : '' }}>6</option>
                <option value="9" {{ shopLimit == 9 ? 'selected' : '' }}>9</option>
                <option value="12" {{ shopLimit == 12 ? 'selected' : '' }}>12</option>
                <option value="18" {{ shopLimit == 18 ? 'selected' : '' }}>18</option>
            </select>
            <span>products</span>
        </div>

        <div class="control-group">
            <label for="shop_q" style="font-weight:600;">Search:</label>
            <input id="shop_q" name="q" type="search" value="{{ shopSearch }}" placeholder="Search by name or category…" style="min-width:220px;">
        </div>

        <div class="control-group">
            <button type="submit" class="collection-submit-btn"><i class="bi bi-search"></i> Search</button>
        </div>
    </form>

    <div class="collection-grid">
        {% for product in products %}
            <div id="product-{{ product.id }}" class="collection-card">
                <div class="collection-media">
                    {% if product.image %}
                        <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}" class="collection-img">
                    {% else %}
                        <div class="collection-no-img">No Image</div>
                    {% endif %}
                </div>

                <div class="collection-card-body">
                    <div class="collection-meta">
                        <span class="collection-badge"><i class="bi bi-tag"></i> {{ product.category }}</span>
                    </div>

                    <h3 class="collection-title">{{ product.name }}</h3>

                    <div class="collection-price">
                        ₱{{ product.price|number_format(2, '.', ',') }}
                    </div>

                    <div class="collection-stock">
                        {% if product.quantity > 0 %}
                            <span class="collection-stock-badge collection-stock-badge--ok"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> {{ product.quantity }} in stock</span>
                        {% else %}
                            <span class="collection-stock-badge collection-stock-badge--out"><i class="bi bi-x-circle" aria-hidden="true"></i> Out of stock</span>
                        {% endif %}
                    </div>

                    <div class="collection-actions collection-actions--split">
                        <a href="{{ path('app_product_show', {'id': product.id}) }}" class="collection-btn collection-btn-outline">
                            <i class="bi bi-eye"></i> Details
                        </a>
                        {% if product.quantity > 0 %}
                            <form method="post" action="{{ path('app_cart_add', {'id': product.id}) }}" style="display:inline;" class="js-add-to-cart-form" data-product-id="{{ product.id }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                                <input type="hidden" name="quantity" value="1">
                                <input type="hidden" name="_redirect" value="{{ path('app_product_index', {q: shopSearch, limit: shopLimit, page: shopPage}) ~ '#product-' ~ product.id }}">
                                <button type="submit" class="collection-btn collection-btn-buy">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </button>
                            </form>
                        {% else %}
                            <span class="collection-btn collection-btn-disabled" title="Out of stock"><i class="bi bi-cart-x"></i> Unavailable</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <p class="collection-empty">No products found.</p>
        {% endfor %}
    </div>

    <div class="collection-footer">
        <div class="collection-page-info">
            {% if shopTotal > 0 %}
                {% set start = (shopPage - 1) * shopLimit + 1 %}
                {% set end = min(shopPage * shopLimit, shopTotal) %}
                Showing {{ start }} to {{ end }} of {{ shopTotal }} entries
            {% else %}
                Showing 0 to 0 of 0 entries
            {% endif %}
        </div>

        {% if shopTotalPages > 1 %}
            <nav class="collection-pagination" aria-label="Product pages">
                {% if shopPage > 1 %}
                    <a class="page-btn" href="{{ path('app_product_index', {q: shopSearch, limit: shopLimit, page: shopPage - 1}) }}">‹</a>
                {% else %}
                    <span class="page-btn" aria-disabled="true">‹</span>
                {% endif %}

                {% for p in 1..shopTotalPages %}
                    {% if p == shopPage %}
                        <span class="page-btn is-active">{{ p }}</span>
                    {% else %}
                        <a class="page-btn" href="{{ path('app_product_index', {q: shopSearch, limit: shopLimit, page: p}) }}">{{ p }}</a>
                    {% endif %}
                {% endfor %}

                {% if shopPage < shopTotalPages %}
                    <a class="page-btn" href="{{ path('app_product_index', {q: shopSearch, limit: shopLimit, page: shopPage + 1}) }}">›</a>
                {% else %}
                    <span class="page-btn" aria-disabled="true">›</span>
                {% endif %}
            </nav>
        {% endif %}
    </div>
</div>

<script>
(() => {
    const forms = document.querySelectorAll('.js-add-to-cart-form');
    const toast = document.getElementById('shopCartToast');
    if (!forms.length) return;

    let toastTimer = null;
    const showToast = (message, isError = false) => {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.toggle('is-error', isError);
        toast.classList.add('is-visible');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
            toast.classList.remove('is-visible');
        }, 1600);
    };

    forms.forEach((form) => {
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (!button) return;

            const originalText = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '<i class="bi bi-hourglass-split"></i> Adding...';

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json',
                    },
                });

                const data = await response.json();
                if (!response.ok || !data.success) {
                    showToast(data.message || 'Could not add to cart.', true);
                    button.disabled = false;
                    button.innerHTML = originalText;
                    return;
                }
                showToast(data.message || 'Added to cart.');

                const card = form.closest('.collection-card');
                const badge = card?.querySelector('.collection-stock-badge');
                if (badge && typeof data.remainingStock === 'number') {
                    if (data.remainingStock > 0) {
                        badge.classList.remove('collection-stock-badge--out');
                        badge.classList.add('collection-stock-badge--ok');
                        badge.innerHTML = '<i class="bi bi-check-circle-fill" aria-hidden="true"></i> ' + data.remainingStock + ' in stock';
                    } else {
                        badge.classList.remove('collection-stock-badge--ok');
                        badge.classList.add('collection-stock-badge--out');
                        badge.innerHTML = '<i class="bi bi-x-circle" aria-hidden="true"></i> Out of stock';
                        button.disabled = true;
                        button.classList.add('collection-btn-disabled');
                        button.innerHTML = '<i class="bi bi-cart-x"></i> Unavailable';
                        return;
                    }
                }

                button.disabled = false;
                button.innerHTML = '<i class="bi bi-cart-check"></i> Added';
                window.setTimeout(() => {
                    button.innerHTML = originalText;
                }, 900);
            } catch (e) {
                showToast('Network error. Please try again.', true);
                button.disabled = false;
                button.innerHTML = originalText;
            }
        });
    });
})();
</script>
