{% extends 'base.html.twig' %}

{% block title %}Register - AgriNest{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-visual" style="--auth-visual-image: url('{{ asset('images/flockrir.png') }}');" aria-hidden="true">
            <div class="auth-visual-overlay"></div>
        </div>

        <div class="auth-container">
            <div class="auth-header">
                <img src="{{ asset('images/mainlogo.png') }}" alt="AgriNest Logo" class="auth-brand-logo">
                <h1>Create Account</h1>
                <p>Join AgriNest and start managing your products</p>
            </div>

            {{ form_start(registrationForm, {'attr': {'class': 'auth-form'}}) }}

                <div class="form-group">
                    <label for="{{ registrationForm.email.vars.id }}">Email</label>
                    <div class="input-wrapper">
                        {{ form_widget(registrationForm.email, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Enter your email address',
                                'autocomplete': 'email',
                                'aria-label': 'Email'
                            }
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.email) }}
                </div>

                {# Roles field only shown in admin dashboard, not on registration page #}
                {% if registrationForm.roles is defined %}
                    <div class="form-group roles-group">
                        <label>Select Your Role</label>
                        <div class="role-options">
                            {% for role in registrationForm.roles %}
                                <div class="role-option">
                                    {% if role.vars.value == 'ROLE_ADMIN' %}
                                        {{ form_widget(role, {'attr': {'class': 'role-checkbox'}}) }}
                                        <label for="{{ role.vars.id }}" class="role-label">
                                            <i class="bi bi-shield-fill-check"></i> Admin
                                        </label>
                                    {% else %}
                                        {{ form_widget(role, {'attr': {'class': 'role-checkbox'}}) }}
                                        <label for="{{ role.vars.id }}" class="role-label">
                                            <i class="bi bi-person-badge"></i> Staff
                                        </label>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                        {{ form_errors(registrationForm.roles) }}
                    </div>
                {% endif %}

                <div class="form-group password-group">
                    <label for="{{ registrationForm.plainPassword.first.vars.id }}">Password</label>
                    <div class="input-wrapper">
                        {{ form_widget(registrationForm.plainPassword.first, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Create a password (min. 6 characters)',
                                'autocomplete': 'new-password',
                                'aria-label': 'Password'
                            }
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>

                <div class="form-group password-group">
                    <label for="{{ registrationForm.plainPassword.second.vars.id }}">Confirm Password</label>
                    <div class="input-wrapper">
                        {{ form_widget(registrationForm.plainPassword.second, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Confirm your password',
                                'autocomplete': 'new-password',
                                'aria-label': 'Confirm password'
                            }
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.plainPassword.second) }}
                </div>

                <button type="submit" class="auth-submit-btn">
                    <i class="bi bi-person-plus"></i>
                    Create Account
                </button>
            {{ form_end(registrationForm) }}

            <div class="auth-links">
                <p>Already have an account? <a href="{{ path('app_login') }}">Sign in here</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
