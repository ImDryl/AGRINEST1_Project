{% extends isAdmin|default(false) ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Suppliers {% endblock %}

{% block admin_content %}
    {% embed 'supplier/_index_content.html.twig' %}{% endembed %}
{% endblock %}

{% block body %}
    {% if isAdmin|default(false) %}
        {{ parent() }}
    {% else %}
        {% embed 'supplier/_index_content.html.twig' %}{% endembed %}
    {% endif %}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/product-table.css') }}?v=1">
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {% include 'includes/inline/_supplier_table_js.html.twig' %}
{% endblock %}