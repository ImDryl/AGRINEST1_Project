<div class="page-header">
    <h1>Supplier </h1>
    <a href="{{ path('app_supplier_new') }}" class="btn-add">+ Create new</a>
</div>

<div class="table-card">
<div class="table-controls">
  <div class="control-group">
    <label for="supplierPageLength" style="font-weight:600;">Show</label>
    <select id="supplierPageLength">
      <option value="5">5</option>
      <option value="10" selected>10</option>
      <option value="25">25</option>
      <option value="50">50</option>
      <option value="100">100</option>
    </select>
    <span>entries</span>
  </div>
  <div class="control-group">
    <label for="supplierTableSearch" style="font-weight:600;">Search:</label>
    <input id="supplierTableSearch" type="text" placeholder="Type to filter..." style="min-width:220px;">
  </div>
</div>

<table id="supplierTable" class="styled-table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for supplier in suppliers %}
        <tr>
            <td>{{ supplier.id }}</td>
            <td>{{ supplier.name }}</td>
            <td>{{ supplier.email }}</td>
            <td>{{ supplier.phone }}</td>
            <td>{{ supplier.address }}</td>
            <td>
                {% set canEdit = is_granted('ROLE_ADMIN') or (supplier.createdBy is not null and supplier.createdBy.id == app.user.id) %}
                {% if canEdit %}
                    <a href="{{ path('app_supplier_edit', {'id': supplier.id}) }}" class="btn-action">Edit</a>
                    <form method="post" action="{{ path('app_supplier_delete', {'id': supplier.id}) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete this supplier? This action cannot be undone.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ supplier.id) }}">
                        <button type="submit" class="btn-action" style="background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Delete</button>
                    </form>
                {% else %}
                    <span class="btn-action btn-disabled" title="You can only edit suppliers you created">Edit</span>
                    <span class="btn-action btn-disabled" title="You can only delete suppliers you created">Delete</span>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="6" class="no-data">No records found</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
<div class="table-footer">
  <div id="supplierPageInfo" class="page-info"></div>
  <div id="supplierPagination"></div>
</div>
</div>
