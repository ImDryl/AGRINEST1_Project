{% extends 'base.html.twig' %}

{% block title %}Login - AgriNest{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}

<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-visual" style="--auth-visual-image: url('{{ asset('images/chikensSides.jpg') }}');" aria-hidden="true">
            <div class="auth-visual-overlay"></div>
        </div>

            <div class="auth-container">
                <div class="auth-header">
                    <img src="{{ asset('images/mainlogo.png') }}" alt="AgriNest Logo" class="auth-brand-logo">
                    <h1>Sign In</h1>
                    <p>Access your AgriNest account</p>
                </div>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    <i class="bi bi-check-circle"></i>
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('warning') %}
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle"></i>
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                    {{ message }}
                </div>
            {% endfor %}

            {% if app.user %}
                <div class="logged-in-message">
                    <i class="bi bi-info-circle"></i>
                    You are logged in as <strong>{{ app.user.userIdentifier }}</strong>,
                    <a href="{{ path('app_logout') }}">Logout</a>
                </div>
            {% endif %}

            {% if error %}
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                    {% set msg = error.message is defined and error.message ? error.message : (error.messageKey|trans(error.messageData, 'security')) %}
                    {{ msg }}
                </div>
            {% endif %}

            <form method="post" class="auth-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-group">
                    <label for="input_email">Email</label>
                    <div class="input-wrapper">
                        <input type="text"
                               value="{{ error ? last_username : '' }}"
                               name="email"
                               id="input_email"
                               class="form-control"
                               autocomplete="email"
                               aria-label="Email"
                               required
                               autofocus
                               placeholder="Enter your email">
                    </div>
                </div>

                <div class="form-group">
                    <label for="inputPassword">Password</label>
                    <div class="input-wrapper">
                        <input type="password"
                               name="_password"
                               id="inputPassword"
                               class="form-control"
                               autocomplete="current-password"
                               aria-label="Password"
                               required
                               placeholder="Enter your password">
                    </div>
                </div>

                <button type="submit" class="auth-submit-btn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Sign In
                </button>
            </form>

            <div class="auth-social">
                <a href="{{ path('app_connect_google') }}" class="auth-google-btn">
                    <i class="bi bi-google"></i>
                    Sign in with Google 
                </a>
            </div>

            <div class="auth-links">
                <p>Don't have an account? <a href="{{ path('app_register') }}">Register here</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
