{% extends 'base.html.twig' %}

{% block title %}About Us - AgriNest{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
{% endblock %}

{% block body %}
<nav class="navbar">
    <div class="logo">
        <img src="{{ asset('images/mainlogo.png') }}" alt="AgriNest Logo">
    </div>
    <ul class="nav-links">
        <li><a href="{{ path('app_homepage') }}">Home</a></li>
        <li><a href="{{ path('app_about') }}" class="active">About Us</a></li>
        <li><a href="{{ path('app_product_index') }}">Shop</a></li>
        <li><a href="{{ path('app_contact') }}">Contact</a></li>
        <li><a href="{{ path('app_sell') }}">Sell</a></li>
        {% if app.user %}
            <li><a href="{{ path('app_logout') }}">Logout</a></li>
        {% else %}
            <li><a href="{{ path('app_login') }}"><i class="bi bi-box-arrow-in-right"></i> Login</a></li>
            <li><a href="{{ path('app_register') }}" class="nav-cta">Sign Up</a></li>
        {% endif %}
    </ul>
</nav>

<section class="section about-section">
    <div class="section-title">
        <h2><i class="bi bi-leaf"></i> About AgriNest</h2>
        <p>
            AgriNest is built to make poultry products easy to find and easy to trust. We connect suppliers,
            help maintain clean handling, and keep our selection simple for your everyday needs.
        </p>
    </div>

    <div class="about-content">
        <div class="about-image">
            <img src="{{ asset('images/Poultry-farming-2.webp') }}" alt="Poultry farming">
        </div>

        <div class="about-text">
            <h3>Quality you can see, service you can feel.</h3>
            <p>
                Whether you’re buying <b>eggs</b> for meals or <b>fertilized eggs</b> for breeding, we focus on
                consistent categories, clear product options, and a smooth shopping experience.
            </p>
            <p>
                Our goal is simple: help your household (and your farm plans) stay supplied—without confusion.
            </p>

            <div class="about-features">
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-check2-circle"></i></div>
                    <div class="feature-text">Reliable Supply</div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-droplet"></i></div>
                    <div class="feature-text">Clean Handling</div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-layout-text-window-reverse"></i></div>
                    <div class="feature-text">Clear Product Info</div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-heart"></i></div>
                    <div class="feature-text">Customer Support</div>
                </div>
            </div>

            <div style="margin-top: 28px; display:flex; gap: 12px; flex-wrap: wrap;">
                <a href="{{ path('app_product_index') }}" class="card-btn">
                    <i class="bi bi-bag"></i> Browse Products
                </a>
                <a href="{{ path('app_contact') }}" class="card-btn" style="background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); color: #754c24;">
                    <i class="bi bi-chat-dots"></i> Ask a Question
                </a>
            </div>
        </div>
    </div>

    <div class="section-title" style="margin-top: 56px;">
        <h2><i class="bi bi-lightbulb"></i> How It Works</h2>
        <p>Simple steps that help you buy with confidence and help sellers stay organized.</p>
    </div>

    <div class="contact-grid" style="padding: 0 4rem 10px;">
        <div class="contact-card">
            <h3><i class="bi bi-1-circle"></i> Choose</h3>
            <p>Pick the product you need (eggs, fertilized eggs, chicks, or meat) based on your goals.</p>
        </div>
        <div class="contact-card">
            <h3><i class="bi bi-2-circle"></i> Confirm</h3>
            <p>Review product details clearly so you know what to expect for quality and availability.</p>
        </div>
        <div class="contact-card">
            <h3><i class="bi bi-3-circle"></i> Get Supplied</h3>
            <p>We coordinate consistent supply to help you stay stocked for daily use or breeding.</p>
        </div>
    </div>

    <div class="section-title" style="margin-top: 26px;">
        <h2><i class="bi bi-stars"></i> Quick FAQ</h2>
        <p>Short answers to the most common questions.</p>
    </div>

    <div class="contact-grid" style="padding: 0 4rem 60px;">
        <div class="contact-card" style="text-align:left;">
            <h3 style="justify-content:flex-start;"><i class="bi bi-question-circle"></i> Are fertilized eggs available?</h3>
            <p>Availability depends on stock. If it’s needed for breeding, contact us and we will guide you.</p>
        </div>
        <div class="contact-card" style="text-align:left;">
            <h3 style="justify-content:flex-start;"><i class="bi bi-receipt-cutoff"></i> Do you track inventory?</h3>
            <p>Yes. Orders adjust product quantities so the shop stays accurate.</p>
        </div>
        <div class="contact-card" style="text-align:left;">
            <h3 style="justify-content:flex-start;"><i class="bi bi-shield-check"></i> What makes AgriNest different?</h3>
            <p>Clear product categories, consistent handling, and a support team that helps you choose correctly.</p>
        </div>
    </div>
</section>

<footer class="footer">
    <p>© 2025 AgriNest. Fresh from the Nest <i class="bi bi-heart-fill"></i></p>
</footer>
{% endblock %}

