<!-- Login Modal -->
<div id="loginModal" class="modal-overlay">
    <div class="modal-container">
        <button type="button" class="modal-close" aria-label="Close">
            <i class="bi bi-x-lg"></i>
        </button>
        <div class="modal-content">
            <div class="modal-header">
                <div class="logo-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h1>Welcome Back</h1>
                <p>Sign in to your AgriNest account</p>
            </div>

            {% for message in app.flashes('success') %}
                <div class="modal-alert modal-alert-success">
                    <i class="bi bi-check-circle"></i>
                    {{ message }}
                </div>
            {% endfor %}

            {% if error %}
                <div class="modal-alert modal-alert-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                    {% set msg = error.message is defined and error.message ? error.message : (error.messageKey|trans(error.messageData, 'security')) %}
                    {{ msg }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="modal-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-group">
                    <label for="modal_username">
                        <i class="bi bi-person"></i> Username
                    </label>
                    <div class="input-wrapper">
                        <input type="text" 
                               value="{{ last_username|default('') }}" 
                               name="_username" 
                               id="modal_username" 
                               class="form-control" 
                               autocomplete="username" 
                               required 
                               placeholder="Enter your username">
                    </div>
                </div>

                <div class="form-group">
                    <label for="modal_password">
                        <i class="bi bi-lock"></i> Password
                    </label>
                    <div class="input-wrapper">
                        <input type="password" 
                               name="_password" 
                               id="modal_password" 
                               class="form-control" 
                               autocomplete="current-password" 
                               required 
                               placeholder="Enter your password">
                    </div>
                </div>

                <button type="submit" class="modal-submit-btn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Sign In
                </button>
            </form>

            <div class="modal-links">
                <p>Don't have an account? <a href="#" data-switch-modal="registerModal">Register here</a></p>
            </div>
        </div>
    </div>
</div>

