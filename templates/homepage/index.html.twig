{% extends 'base.html.twig' %}

{% block title %}AgriNest - Quality Eggs & Poultry Products{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
{% endblock %}

{% block body %}
<nav class="navbar">
    <div class="logo">
        <img src="{{ asset('images/mainlogo.png') }}" alt="AgriNest Logo">
    </div>
    <ul class="nav-links">
        <li><a href="{{ path('app_homepage') }}" class="active">Home</a></li>
        <li><a href="#about">About Us</a></li>
        <li><a href="#shop">Shop</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="#sell">Sell</a></li>
    </ul>
</nav>

<section class="hero">
    <div class="hero-content">
        <h1>Welcome to AgriNest</h1>
        <p>Your trusted source for fresh eggs, healthy chicks, and poultry products</p>
        <a href="#shop" class="btn-primary">Shop Now</a>
    </div>
</section>

<section class="products">
    <div class="card">
        <h3>🥚 Native Eggs</h3>
        <p>Fresh and nutritious native chicken eggs.</p>
    </div>
    <div class="card">
        <h3>🐣 Fertilized Eggs</h3>
        <p>High-quality fertilized eggs for breeding.</p>
    </div>
    <div class="card">
        <h3>🍳 Table Eggs</h3>
        <p>Clean and farm-fresh table eggs for your family.</p>
    </div>
    <div class="card">
        <h3>🐥 Chicks & Livestock</h3>
        <p>Strong, healthy chicks and poultry livestock.</p>
    </div>
    <div class="card">
        <h3>🍗 Fresh Meat</h3>
        <p>Farm-raised chicken meat for your table.</p>
    </div>
</section>

<footer class="footer">
    <p>© 2025 AgriNest. Fresh from the Nest 🐓</p>
</footer>
{% endblock %}
