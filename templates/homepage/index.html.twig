{% extends 'base.html.twig' %}

{% block title %}AgriNest{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
    <link rel="stylesheet" href="{{ asset('css/modal.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'includes/inline/_modal_js.html.twig' %}
{% endblock %}

{% block body %}
<nav class="navbar">
    <div class="logo">
        <img src="{{ asset('images/mainlogo.png') }}" alt="AgriNest Logo">
    </div>
    <ul class="nav-links">
        <li><a href="{{ path('app_homepage') }}" class="active">Home</a></li>
        <li><a href="#about">About Us</a></li>
        <li><a href="#shop">Shop</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="#sell">Sell</a></li>
        {% if app.user %}
            <li><a href="{{ path('app_logout') }}">Logout</a></li>
        {% else %}
            <li><a href="#" data-modal="login"><i class="bi bi-box-arrow-in-right"></i> Login</a></li>
            <li><a href="#" data-modal="register" class="nav-cta">Sign Up</a></li>
        {% endif %}
    </ul>
</nav>

<section class="hero">
    <div class="hero-content">
        <h1>Welcome to AgriNest</h1>
        <p>Your trusted source for fresh eggs, healthy chicks, and poultry products</p>
        <div class="hero-buttons">
            <a href="#shop" class="btn-primary"><i class="bi bi-bag"></i> Shop Now</a>
            <a href="#about" class="btn-secondary"><i class="bi bi-info-circle"></i> About Us</a>
        </div>
    </div>
</section>

<section id="about" class="section about-section">
    <div class="section-title">
        <h2><i class="bi bi-leaf"></i> About AgriNest</h2>
        <p>
            AgriNest connects farmers to families with fresh, quality poultry products. We focus on dependable supply,
            clean handling, and happy customers.
        </p>
    </div>

    <div class="about-content">
        <div class="about-image">
            <img src="{{ asset('images/Poultry-farming-2.webp') }}" alt="Poultry farming">
        </div>

        <div class="about-text">
            <h3>Fresh products, reliable stock.</h3>
            <p>
                Whether you need eggs for everyday meals or fertilized eggs for breeding, AgriNest makes it easy to
                choose what you need with clear product categories and consistent availability.
            </p>

            <div class="about-features">
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                    <div class="feature-text">Quality First</div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-clipboard-check"></i></div>
                    <div class="feature-text">Clean & Safe</div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="feature-text">Clear Categories</div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-people"></i></div>
                    <div class="feature-text">Community Support</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="shop" class="section products-section">
    <div class="section-title">
        <h2><i class="bi bi-cart"></i> Products</h2>
        <p>Explore our most requested items. Click below to view all products in the shop.</p>
    </div>

    <div class="products">
     
        <div class="card">
            <img class="card-image" src="{{ asset('images/FertilizedEggs.png') }}" alt="Fertilized Eggs">
            <div class="card-content">
                <h3><i class="bi bi-egg"></i> Fertilized Eggs</h3>
                <p>High-quality fertilized eggs for breeding.</p>
                <a href="{{ path('app_product_index') }}" class="card-btn"><i class="bi bi-arrow-right"></i> View Products</a>
            </div>
        </div>

        <div class="card">
            <img class="card-image" src="{{ asset('images/TableEggs.jpg') }}" alt="Table Eggs">
            <div class="card-content">
                <h3><i class="bi bi-egg-fried"></i> Table Eggs</h3>
                <p>Clean and farm-fresh table eggs for your family.</p>
                <a href="{{ path('app_product_index') }}" class="card-btn"><i class="bi bi-arrow-right"></i> View Products</a>
            </div>
        </div>

        <div class="card">
            <img class="card-image" src="{{ asset('images/Chicks.jpg') }}" alt="Chicks & Livestock">
            <div class="card-content">
                <h3><i class="bi bi-egg"></i> Chicks & Livestock</h3>
                <p>Strong, healthy chicks and poultry livestock.</p>
                <a href="{{ path('app_product_index') }}" class="card-btn"><i class="bi bi-arrow-right"></i> View Products</a>
            </div>
        </div>

        <div class="card">
            <img class="card-image" src="{{ asset('images/Meat.jpg') }}" alt="Fresh Meat">
            <div class="card-content">
                <h3><i class="bi bi-cup-hot"></i> Fresh Meat</h3>
                <p>Farm-raised chicken meat for your table.</p>
                <a href="{{ path('app_product_index') }}" class="card-btn"><i class="bi bi-arrow-right"></i> View Products</a>
            </div>
        </div>
    </div>
</section>

<section id="sell" class="section about-section">
    <div class="section-title">
        <h2><i class="bi bi-hand-thumbs-up"></i> Sell with AgriNest</h2>
        <p>Partner with us and help grow a clean, reliable poultry supply for your community.</p>
    </div>

    <div class="contact-grid">
        <div class="contact-card">
            <h3><i class="bi bi-person-plus"></i> Become a Seller</h3>
            <p>Create an account and start listing your products through AgriNest.</p>
            <a href="{{ path('app_register') }}" class="card-btn"><i class="bi bi-arrow-right"></i> Sign Up</a>
        </div>

        <div class="contact-card">
            <h3><i class="bi bi-chat"></i> Need Help?</h3>
            <p>Questions about partnership or requirements? Reach out to our team.</p>
            <a href="#contact" class="card-btn"><i class="bi bi-arrow-right"></i> Contact Us</a>
        </div>
    </div>
</section>

<section id="contact" class="section contact-section">
    <div class="section-title">
        <h2><i class="bi bi-chat-dots"></i> Contact</h2>
        <p>Have questions? Reach out and we will get back to you as soon as possible.</p>
    </div>

    <div class="contact-grid">
        <div class="contact-card">
            <h3><i class="bi bi-envelope"></i> Email</h3>
            <p>support@agrinest.com</p>
            <a href="mailto:support@agrinest.com" class="card-btn"><i class="bi bi-send"></i> Send Email</a>
        </div>

        <div class="contact-card">
            <h3><i class="bi bi-telephone"></i> Phone</h3>
            <p>+63 000 000 0000</p>
            <a href="tel:+630000000000" class="card-btn"><i class="bi bi-telephone"></i> Call Us</a>
        </div>

        <div class="contact-card">
            <h3><i class="bi bi-geo-alt"></i> Location</h3>
            <p>Your Farm Hub, Philippines</p>
            <a href="#shop" class="card-btn"><i class="bi bi-bag"></i> Browse Products</a>
        </div>
    </div>
</section>

<footer class="footer">
    <p>© 2025 AgriNest. Fresh from the Nest <i class="bi bi-heart-fill"></i></p>
</footer>

{# Include Modals #}
{% if not app.user %}
    {{ include('homepage/_login_modal.html.twig') }}
    {{ include('homepage/_register_modal.html.twig') }}
    
    {# Auto-open modal if there are form errors or login error #}
    {% if error %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const loginModal = document.getElementById('loginModal');
                if (loginModal) {
                    loginModal.classList.add('active');
                    document.body.classList.add('modal-open');
                }
            });
        </script>
    {% elseif registrationForm.vars.submitted and not registrationForm.vars.valid %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const registerModal = document.getElementById('registerModal');
                if (registerModal) {
                    registerModal.classList.add('active');
                    document.body.classList.add('modal-open');
                }
            });
        </script>
    {% endif %}
{% endif %}
{% endblock %}
