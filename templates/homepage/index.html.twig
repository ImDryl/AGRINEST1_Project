{% extends 'base.html.twig' %}

{% block title %}AgriNest{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
{% include 'includes/_navbar_public.html.twig' %}

<section class="hero">
    <div class="hero-content">
        <h1>Welcome to AgriNest</h1>
        <p>Your trusted source for fresh eggs, healthy chicks, and poultry products</p>
        <div class="hero-buttons">
            {% if app.user %}
                <a href="{{ path('app_product_index') }}" class="btn-primary"><i class="bi bi-bag"></i> Shop Now</a>
            {% else %}
                <a href="{{ path('app_product_index') }}" class="btn-primary"><i class="bi bi-bag"></i> Shop Now</a>
            {% endif %}
            <a href="{{ path('app_about') }}" class="btn-primary"><i class="bi bi-info-circle"></i> About Us</a>
        </div>
    </div>
</section>

<section class="section home-trust-section">
    <div class="home-trust-grid">
        <article class="home-trust-card">
            <div class="home-trust-icon"><i class="bi bi-bag-check"></i></div>
            <h3>1,000+ Orders Served</h3>
            <p>Families, resellers, and farm partners choose AgriNest for reliable poultry supply.</p>
        </article>
        <article class="home-trust-card">
            <div class="home-trust-icon"><i class="bi bi-shield-check"></i></div>
            <h3>Quality Checked Daily</h3>
            <p>Fresh handling, clear categories, and stock visibility for better buying decisions.</p>
        </article>
        <article class="home-trust-card">
            <div class="home-trust-icon"><i class="bi bi-truck"></i></div>
            <h3>Supplier to Customer Flow</h3>
            <p>From listing to checkout, AgriNest helps connect sellers and buyers faster.</p>
        </article>
    </div>
</section>

<section class="section home-process-section">
    <div class="section-title">
        <h2><i class="bi bi-diagram-3"></i> How AgriNest Works</h2>
        <p>A simple process designed for both buyers and poultry sellers.</p>
    </div>
    <div class="home-process-grid">
        <article class="home-process-card">
            <span class="home-process-step">01</span>
            <h3>Browse products</h3>
            <p>Explore chicks, eggs, and poultry items with clear stock and pricing.</p>
        </article>
        <article class="home-process-card">
            <span class="home-process-step">02</span>
            <h3>Add to cart</h3>
            <p>Select quantity and keep track of your order in one organized cart flow.</p>
        </article>
        <article class="home-process-card">
            <span class="home-process-step">03</span>
            <h3>Checkout confidently</h3>
            <p>Submit your details, place order, and coordinate fulfillment with ease.</p>
        </article>
    </div>
</section>

<section id="about" class="section about-section">
    <div class="section-title">
        <h2><i class="bi bi-leaf"></i> About AgriNest</h2>
        <p>
            AgriNest connects farmers to families with fresh, quality poultry products. We focus on dependable supply,
            clean handling, and happy customers.
        </p>
    </div>

    <div class="about-content">
        <div class="about-image">
            <img src="{{ asset('images/chikensSides.jpg') }}" alt="Poultry farming">
        </div>

        <div class="about-text">
            <h3>Fresh products, reliable stock.</h3>
            <p>
                Whether you need eggs for everyday meals or fertilized eggs for breeding, AgriNest makes it easy to
                choose what you need with clear product categories and consistent availability.
            </p>

            <div class="about-features">
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                    <div class="feature-text">Quality First</div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-clipboard-check"></i></div>
                    <div class="feature-text">Clean & Safe</div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="feature-text">Clear Categories</div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-people"></i></div>
                    <div class="feature-text">Community Support</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="shop" class="section products-section">
    <div class="section-title">
        <h2><i class="bi bi-cart"></i> Products</h2>
        <p>Explore our most requested items. Click below to view all products in the shop.</p>
    </div>

    <div class="products">
        <div class="card">
            <img class="card-image" src="{{ asset('images/FertilizedEggs.png') }}" alt="Fertilized Eggs">
            <div class="card-content">
                <h3><i class="bi bi-egg"></i> Fertilized Eggs</h3>
                <p>High-quality fertilized eggs for breeding.</p>
                <a href="{{ path('app_product_index') }}" class="card-btn"><i class="bi bi-arrow-right"></i> View Products</a>
            </div>
        </div>

        <div class="card">
            <img class="card-image" src="{{ asset('images/TableEggs.jpg') }}" alt="Table Eggs">
            <div class="card-content">
                <h3><i class="bi bi-egg-fried"></i> Table Eggs</h3>
                <p>Clean and farm-fresh table eggs for your family.</p>
                <a href="{{ path('app_product_index') }}" class="card-btn"><i class="bi bi-arrow-right"></i> View Products</a>
            </div>
        </div>

        <div class="card">
            <img class="card-image" src="{{ asset('images/Chickss.png') }}" alt="Chicks & Livestock">
            <div class="card-content">
                <h3><i class="bi bi-egg"></i> Chicks & Livestock</h3>
                <p>Strong, healthy chicks and poultry livestock.</p>
                <a href="{{ path('app_product_index') }}" class="card-btn"><i class="bi bi-arrow-right"></i> View Products</a>
            </div>
        </div>

        <div class="card">
            <img class="card-image" src="{{ asset('images/Meat.jpg') }}" alt="Fresh Meat">
            <div class="card-content">
                <h3><i class="bi bi-cup-hot"></i> Fresh Meat</h3>
                <p>Farm-raised chicken meat for your table.</p>
                <a href="{{ path('app_product_index') }}" class="card-btn"><i class="bi bi-arrow-right"></i> View Products</a>
            </div>
        </div>
    </div>
</section>

<section id="sell" class="section about-section">
    <div class="section-title">
        <h2><i class="bi bi-hand-thumbs-up"></i> Sell with AgriNest</h2>
        <p>
            Eggstra income opportunity for first-time sellers and growing farm businesses.
            Start your seller journey with AgriNest and reach more buyers through one trusted poultry marketplace.
        </p>
    </div>

    <div class="contact-grid">
        <div class="contact-card">
            <h3><i class="bi bi-person-plus"></i> Become a Seller</h3>
            <p>
                Create your account, submit your product details, and start listing eggs or poultry items with a
                quick and guided setup process.
            </p>
            <a href="{{ path('app_register') }}" class="card-btn"><i class="bi bi-arrow-right"></i> Sign Up</a>
        </div>

        <div class="contact-card">
            <h3><i class="bi bi-cash-coin"></i> Grow Your Income</h3>
            <p>
                Save time, reach repeat customers, and scale your sales with clear product categories,
                organized inventory flow, and support from the AgriNest team.
            </p>
            <a href="{{ path('app_contact') }}" class="card-btn"><i class="bi bi-arrow-right"></i> Contact Us</a>
        </div>
    </div>
</section>

<section id="contact" class="section contact-section">
    <div class="section-title">
        <h2><i class="bi bi-chat-dots"></i> Contact</h2>
        <p>Have questions? Reach out and we will get back to you as soon as possible.</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="contact-flash contact-flash-success">
            <i class="bi bi-check-circle"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="contact-flash contact-flash-error">
            <i class="bi bi-exclamation-triangle"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="contact-dual">
        <div class="contact-feedback-card">
            <h3><i class="bi bi-chat-square-text"></i> Inquiry Form</h3>
            <p class="contact-feedback-intro">Tell us what you need and we will reply as soon as we can.</p>

            {{ form_start(contactForm, {'attr': {'class': 'contact-feedback-form'}}) }}
            <div class="contact-form-grid">
                <div class="contact-form-field">
                    {{ form_label(contactForm.name) }}
                    {{ form_widget(contactForm.name) }}
                    {{ form_errors(contactForm.name) }}
                </div>
                <div class="contact-form-field">
                    {{ form_label(contactForm.email) }}
                    {{ form_widget(contactForm.email) }}
                    {{ form_errors(contactForm.email) }}
                </div>
            </div>
            <div class="contact-form-field">
                {{ form_label(contactForm.subject) }}
                {{ form_widget(contactForm.subject) }}
                {{ form_errors(contactForm.subject) }}
            </div>
            <div class="contact-form-field">
                {{ form_label(contactForm.message) }}
                {{ form_widget(contactForm.message) }}
                {{ form_errors(contactForm.message) }}
            </div>

            <button type="submit" class="card-btn contact-submit-btn">
                <i class="bi bi-send-fill"></i> Send
            </button>
            {{ form_end(contactForm) }}
        </div>

        <aside class="contact-info-panel">
            <h3><i class="bi bi-person-lines-fill"></i> Contact Information</h3>
            <ul class="contact-info-list">
                <li><i class="bi bi-geo-alt-fill"></i><span>Agrinest, Philippines</span></li>
                <li><i class="bi bi-telephone-fill"></i><span>+63 981 558 9791</span></li>
                <li><i class="bi bi-envelope-fill"></i><span>support@agrinest.com</span></li>
                <li><i class="bi bi-facebook"></i><span>facebook.com/agrinest</span></li>
                <li><i class="bi bi-instagram"></i><span>@agrinest</span></li>
            </ul>
            <div class="contact-info-actions">
                <a href="mailto:support@agrinest.com" class="card-btn"><i class="bi bi-send"></i> Email Support</a>
                <a href="{{ path('app_product_index') }}" class="card-btn"><i class="bi bi-bag"></i> Browse Products</a>
            </div>
        </aside>
    </div>
</section>

{{ include('homepage/_footer.html.twig') }}
{% endblock %}
