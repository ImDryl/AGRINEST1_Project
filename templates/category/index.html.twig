{% extends isAdmin|default(false) ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Category List{% endblock %}

{% block admin_content %}
    {% embed 'category/_index_content.html.twig' %}{% endembed %}
{% endblock %}

{% block body %}
    {% if isAdmin|default(false) %}
        {{ parent() }}
    {% else %}
        {% embed 'category/_index_content.html.twig' %}{% endembed %}
    {% endif %}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {% include 'includes/inline/_category_table_js.html.twig' %}
{% endblock %}