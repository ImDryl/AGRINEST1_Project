{% extends 'admin/base_admin.html.twig' %}

{% block title %}Create New Category{% endblock %}

{% block admin_content %}
  <div class="form-container">
      <h1><i class="bi bi-plus-circle"></i> Create New Category</h1>

      {{ form_start(form) }}
          {{ form_widget(form) }}
          <div class="form-actions">
              <button class="btn btn-success btn-sm category-save-btn"><i class="bi bi-save"></i> Save</button>
              <a href="{{ path('app_category_index') }}" class="btn btn-secondary btn-sm category-back-btn"><i class="bi bi-arrow-left"></i> Back to list</a>
          </div>
      {{ form_end(form) }}
  </div>
{% endblock %}
