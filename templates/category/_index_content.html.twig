<div class="page-header">
    <h1><i class="bi bi-tags"></i> Category List</h1>
    <a href="{{ path('app_category_new') }}" class="btn btn-add category-create-btn"><i class="bi bi-plus-circle"></i> Create New Category</a>
</div>

<div class="card table-flat-card category-list-card">
    <div class="table-controls">
        <div class="control-group">
            <label for="categoryPageLength" style="font-weight:600;">Show</label>
            <select id="categoryPageLength">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span>entries</span>
        </div>
        <div class="control-group">
            <label for="categoryTableSearch" style="font-weight:600;">Search:</label>
            <input id="categoryTableSearch" type="text" placeholder="Type to filter..." style="min-width:220px;">
        </div>
    </div>
    <table id="categoryTable" class="styled-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for category in categories %}
                <tr>
                    <td>{{ category.id }}</td>
                    <td>{{ category.name }}</td>
                    <td class="table-actions">
                        {# <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn btn-view"><i class="bi bi-eye"></i> View</a> #}
                        {% set canEdit = is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or (category.createdBy is not null and category.createdBy.id == app.user.id) %}
                        {% set canDelete = is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or (category.createdBy is not null and category.createdBy.id == app.user.id) %}
                        {% if canEdit %}
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-edit icon-btn" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        {% else %}
                            <span class="btn btn-edit btn-disabled icon-btn" title="You can only edit categories you created">
                                <i class="bi bi-pencil"></i>
                            </span>
                        {% endif %}
                        {% if canDelete %}
                            <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete this category? This action cannot be undone.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                <button type="submit" class="btn btn-delete icon-btn" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        {% else %}
                            <span class="btn btn-delete btn-disabled icon-btn" title="You can only delete categories you created">
                                <i class="bi bi-trash"></i>
                            </span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="no-data">No categories found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="table-footer">
      <div id="categoryPageInfo" class="page-info"></div>
      <div id="categoryPagination"></div>
    </div>
</div>
